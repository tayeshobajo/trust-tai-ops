# QA auto-login is a local-development affordance only. It is off here and is
# hard-disabled for production builds in src/env.ts. No credential of any kind
# belongs in this file.
VITE_OPS_QA_AUTOLOGIN=false

# Trust Tai OS suite integration. Browser-safe values only: the OS project URL,
# the OS publishable/anon key, and the exact origins allowed to hand off a
# session by postMessage. No wildcards.
VITE_OPS_OS_SUPABASE_URL=https://okydosoacqdnursmmenf.supabase.co
VITE_OPS_OS_SUPABASE_PUBLISHABLE_KEY=sb_publishable_uARvNwZli88tfhOHBwFTsQ_JUpQo-UL
