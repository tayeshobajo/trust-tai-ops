{
  "name": "ops-trust-tai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:dev": "vite build --mode development",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check:agent": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/agent-core-checks.ts",
    "check:autonomy": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/autonomy-checks.ts",
    "check:browser": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/browser-checks.ts",
    "check:private": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/private-access-checks.ts",
    "check:wpcli": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/wpcli-checks.ts",
    "check:logs": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/log-checks.ts",
    "check:reasoner": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/reasoner-checks.ts",
    "check:meetings": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/meeting-checks.ts",
    "check:migrations": "node --experimental-strip-types --no-warnings scripts/migration-checks.ts",
    "check:stacks": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/stack-checks.ts",
    "check:chat-secrets": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/chat-secret-checks.ts",
    "check:evidence": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/evidence-checks.ts",
    "check:continuity": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/continuity-checks.ts",
    "check:production": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/production-readiness-checks.ts",
    "check:continuity-e2e": "node --experimental-strip-types --no-warnings --import ./scripts/ts-resolve-loader.mjs scripts/continuity-e2e.ts",
    "check:all": "npm run check:agent && npm run check:autonomy && npm run check:browser && npm run check:private && npm run check:wpcli && npm run check:logs && npm run check:reasoner && npm run check:meetings && npm run check:migrations && npm run check:stacks && npm run check:chat-secrets && npm run check:evidence && npm run check:continuity && npm run check:continuity-e2e && npm run check:production"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.30.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.0"
  }
}
