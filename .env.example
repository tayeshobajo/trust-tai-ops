# ===========================================================================
# FRONTEND / PUBLIC ONLY
# ---------------------------------------------------------------------------
# Everything below is compiled into the browser bundle and is readable by
# anyone who loads the app. Public values only.
# ===========================================================================
VITE_OPS_REPOSITORY_ADAPTER=auto
VITE_OPS_SUBDOMAIN=ops.trusttai.com

# The project's public Supabase URL.
VITE_OPS_SUPABASE_URL=https://your-ops-project.supabase.co
# The public anon / publishable key. VITE_OPS_SUPABASE_ANON_KEY is accepted as
# a legacy alias for the same value.
VITE_OPS_SUPABASE_PUBLISHABLE_KEY=replace-with-public-supabase-key
VITE_OPS_SUPABASE_SCHEMA=public

# ===========================================================================
# EDGE FUNCTION / SERVER ONLY — NEVER IN THIS FILE, NEVER WITH A VITE_ PREFIX
# ---------------------------------------------------------------------------
# These belong in Supabase Edge Function secrets:
#
#   supabase secrets set AGENT_SECRET_ENCRYPTION_KEY=...
#
# SUPABASE_URL                 Injected automatically into Edge Functions.
# SUPABASE_ANON_KEY            Only if used to verify caller token claims.
# SUPABASE_SERVICE_ROLE_KEY    Injected automatically into Edge Functions.
# AGENT_SECRET_ENCRYPTION_KEY  32-byte key (base64 or 64 hex chars) that seals
#                              stored WordPress Application Passwords. Without
#                              it, credentials are refused rather than stored in
#                              the clear. Rotating it makes existing sealed
#                              credentials unreadable; they must be re-entered.
#
# The service-role key and the encryption key must NEVER carry a VITE_ prefix
# and must NEVER enter browser env. Anything prefixed VITE_ is compiled into the
# bundle: a service-role key there is a full database compromise, and an
# encryption key there makes every sealed credential readable.
# ===========================================================================

# ---------------------------------------------------------------------------
# TENANT IDENTITY: UID FIRST
# ---------------------------------------------------------------------------
# users.auth_user_id is the preferred claim; identity resolves from auth.uid().
# Email matching is a transitional fallback for unmigrated rows only and is a
# weaker claim. Backfill users.auth_user_id during production rollout, then
# remove reliance on email matching.
# ---------------------------------------------------------------------------
