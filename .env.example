VITE_OPS_REPOSITORY_ADAPTER=auto
VITE_OPS_SUBDOMAIN=ops.trust-tai.com

# Browser-safe Supabase config only.
# Never place a service-role key in a Vite env file.
VITE_OPS_SUPABASE_URL=https://your-ops-project.supabase.co
VITE_OPS_SUPABASE_PUBLISHABLE_KEY=replace-with-public-supabase-key
VITE_OPS_SUPABASE_SCHEMA=public

# ---------------------------------------------------------------------------
# Server-only. These belong in Supabase Edge Function secrets, never here and
# never in any VITE_ variable — anything prefixed VITE_ is compiled into the
# browser bundle and is readable by anyone who loads the app.
#
#   supabase secrets set AGENT_SECRET_ENCRYPTION_KEY=...
#
# AGENT_SECRET_ENCRYPTION_KEY  32-byte key (base64 or 64 chars) that seals
#                              stored WordPress Application Passwords.
#                              Without it, credentials are refused rather than
#                              stored in the clear. Rotating it makes existing
#                              sealed credentials unreadable; they must be
#                              re-entered.
# SUPABASE_SERVICE_ROLE_KEY    Injected automatically into Edge Functions.
# SUPABASE_URL                 Injected automatically into Edge Functions.
# ---------------------------------------------------------------------------
